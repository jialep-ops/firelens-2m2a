{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "firelens-2m2a",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "vars": {
    "LLM_PROVIDER": "vt-arc",
    "ARC_MODEL": "gpt-oss-120b"
  },
  "build": {
    "command": "npm run build"
  }
}
